# ==============================================================================
# AgroRent Frontend Environment Variables Template (Vite)
#
# INSTRUCTIONS:
# - For local development, copy this file to: frontend/.env.local
# - For production hosting on Vercel, configure this variable in Project Settings -> Environment Variables.
#
# IMPORTANT SECURITY NOTICE:
# - All variables starting with VITE_ are embedded into the client-side JavaScript bundle during build.
# - DO NOT place private API keys, database credentials, server secrets, or JWT secrets in this file.
# ==============================================================================

# Backend REST API base URL (must include the '/api' prefix, no trailing slash)
# Local development default:
VITE_API_BASE_URL=http://localhost:8080/api

# Production example (Render backend deployment):
# VITE_API_BASE_URL=https://agrorent-backend.onrender.com/api
