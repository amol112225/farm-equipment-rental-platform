# ==============================================================================
# AgroRent Backend Environment Variables Template (.env.example)
#
# INSTRUCTIONS & IMPORTANT NOTES:
# - Standard Spring Boot does NOT automatically read a .env file at startup.
# - For local development, choose one of the supported methods below to load values:
#
#   Method A (Direct PowerShell session - Recommended):
#     $env:SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/agrorent_db"
#     $env:SPRING_DATASOURCE_USERNAME="postgres"
#     $env:SPRING_DATASOURCE_PASSWORD="your_local_password"
#     $env:JWT_SECRET="your_local_jwt_secret_min_32_chars_long"
#     mvn spring-boot:run
#
#   Method B (Load from a local backend/.env file via PowerShell before running):
#     Get-Content .env | Where-Object { $_ -notmatch '^\s*#' -and $_ -match '=' } | ForEach-Object { $k,$v = $_.Split('=',2); [System.Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim(), 'Process') }
#     mvn spring-boot:run
#
#   Method C (IDE Run Configuration / launch.json / application-local.properties):
#     Pass environment variables in your IDE's Run/Debug Configuration dialog.
#
# - For production hosting on Render with Supabase PostgreSQL:
#   Add each variable under Render Dashboard -> Web Service -> Environment Variables.
#   NOTE: Render operates on an IPv4 network. Connecting to Supabase via its
#   Session Pooler (port 5432) resolves via IPv4, ensuring reliable connectivity on Render.
#
# CRITICAL SECURITY RULES:
# - NEVER commit real production passwords, database secrets, or JWT secrets to Git.
# - Keep .env listed in .gitignore at all times.
# ==============================================================================

# Active Spring Profile ('prod' for production hosting, 'dev' or omitted for local development)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render dynamically injects PORT; local default is 8080)
PORT=8080
SERVER_PORT=8080

# Production Managed Supabase PostgreSQL Database Connectivity
# Option 1: Supabase Session Pooler (RECOMMENDED for Render IPv4):
#   Host: aws-0-[REGION].pooler.supabase.com | Port: 5432 | User: postgres.[PROJECT-REF]
# Option 2: Supabase Direct Connection (Requires IPv4 add-on if on IPv4 host):
#   Host: db.[PROJECT-REF].supabase.co | Port: 5432 | User: postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.[PROJECT-REF]
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# JPA & Hibernate Schema Management
# For production, 'validate' is strongly recommended to protect existing data from schema changes.
# For local development, 'update' can be used.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# JWT Secret Key
# MUST be a cryptographically secure, random secret with a minimum of 256 bits (32 characters).
# Example generation command in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG

# Allowed CORS Origins
# Comma-separated list of frontend URLs permitted to call this backend.
# Replace with your deployed Vercel domain in production:
CORS_ALLOWED_ORIGINS=https://YOUR_APP.vercel.app

# Cloudinary Persistent Object Storage (Milestone 2 - Equipment Photo Upload)
# Required for production deployments on Render where container filesystems are ephemeral.
# If omitted or left empty, the application automatically falls back to local filesystem storage.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Local development upload directory (defaults to uploads/equipment)
UPLOAD_DIR=uploads/equipment

