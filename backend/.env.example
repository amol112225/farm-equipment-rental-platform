# ==============================================================================
# AgroRent Backend Environment Variables Template (.env.example)
#
# INSTRUCTIONS:
# - For local development, copy this file to: backend/.env
#   (or set these variables in your Windows PowerShell terminal session).
# - For production hosting on Render:
#   Add each variable under Render Dashboard -> Service -> Environment Variables.
#
# CRITICAL SECURITY RULES:
# - NEVER commit real production passwords or JWT secrets to Git.
# - Keep .env listed in .gitignore at all times.
# ==============================================================================

# Active Spring Profile ('prod' for production hosting, 'dev' or omitted for local development)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render dynamically injects PORT; local default is 8080)
PORT=8080
SERVER_PORT=8080

# Production Managed MySQL Database Connectivity
# Example for Render MySQL / Aiven / Railway / PlanetScale / AWS RDS:
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_DB_HOST:3306/YOUR_DATABASE?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=YOUR_DB_USERNAME
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_YOUR_STRONG_DB_PASSWORD

# JPA & Hibernate Schema Management
# For production, 'validate' is strongly recommended to protect existing data from schema changes.
# For local development, 'update' can be used.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# JWT Secret Key
# MUST be a cryptographically secure, random secret with a minimum of 256 bits (32 characters).
# Example generation command in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG

# Allowed CORS Origins
# Comma-separated list of frontend URLs permitted to call this backend.
# Replace with your deployed Vercel domain in production:
CORS_ALLOWED_ORIGINS=https://YOUR_APP.vercel.app
