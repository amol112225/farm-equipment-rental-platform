# ==============================================================================
# AgroRent Root .gitignore
# Excludes compiled build targets, local dependencies, environment secrets, and IDE files
# ==============================================================================

# Node dependencies and build output
node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/

# Java & Maven build output
target/
backend/target/
*.class
*.jar
*.war
*.ear

# Environment configuration & local secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# Logs and runtime dumps
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db

# IDE and Editor configurations
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.settings/
.project
.classpath
